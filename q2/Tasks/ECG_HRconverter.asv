function HR = ECG_HRconverter(E, ts)
    [pks, locs] = findpeaks(E,'MinPeakProminence',1);
    hr1 = ones(1,length(pks));

    tts = 0:ts:(length(E)-1)*ts;

    idx = 2;
    prev = 0;
    tt = 0;

    for l = 1:length(pks) 
        if (prev == 0)
            prev = locs(l);
            continue;
        end
        time = (locs(l) - prev)*ts;
        hr1(idx) = 60/time;
    
        if (hr1(idx) >= 230) 
            hr1(idx) = hr1(idx-1);
        end
    
        tt = [tt, time+((prev)*ts)];
        
        idx = idx + 1;
        prev = locs(l);
    end
    

    h = interp1(tt,hr1,tts);
end